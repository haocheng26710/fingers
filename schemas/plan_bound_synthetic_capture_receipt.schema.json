        "proxy_state": {
          "title": "Proxy State",
          "type": "boolean"
        },
        "state_id": {
          "title": "State Id",
          "type": "string"
        },
        "state_type": {
          "title": "State Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "node_id",
        "state_id",
        "module_id",
        "state_type",
        "discrete_label",
        "continuous_value",
        "unit",
        "loading_direction",
        "proxy_state",
        "provenance",
        "notes"
