{
  "$defs": {
    "BlockTraceRecord": {
      "additionalProperties": false,
      "properties": {
        "input_frame_count": {
          "minimum": 0,
          "title": "Input Frame Count",
          "type": "integer"
        },
        "output_frame_count": {
          "minimum": 0,
          "title": "Output Frame Count",
          "type": "integer"
        },
        "requested_frame_count": {
          "exclusiveMinimum": 0,
          "title": "Requested Frame Count",
          "type": "integer"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "status_flags": {
          "items": {
            "type": "string"
          },
          "title": "Status Flags",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "start_frame",
        "requested_frame_count",
        "output_frame_count",
        "input_frame_count",
        "status_flags"
      ],
      "title": "BlockTraceRecord",
      "type": "object"
    },
    "CaptureFaultCounters": {
      "additionalProperties": false,
      "properties": {
        "clipping_count": {
          "minimum": 0,
          "title": "Clipping Count",
          "type": "integer"
        },
        "dropout_count": {
          "minimum": 0,
          "title": "Dropout Count",
          "type": "integer"
        },
        "error_count": {
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "short_read_count": {
          "minimum": 0,
          "title": "Short Read Count",
          "type": "integer"
        },
        "xrun_count": {
          "minimum": 0,
          "title": "Xrun Count",
          "type": "integer"
        }
