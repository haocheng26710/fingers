      "title": "NodeState",
      "type": "object"
    },
    "StateTransitionRecord": {
      "additionalProperties": false,
      "properties": {
        "completed_block_count": {
          "minimum": 0,
          "title": "Completed Block Count",
          "type": "integer"
        },
        "from_state": {
          "$ref": "#/$defs/CaptureState"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sample_cursor": {
          "minimum": 0,
          "title": "Sample Cursor",
          "type": "integer"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "to_state": {
          "$ref": "#/$defs/CaptureState"
        }
      },
      "required": [
        "sequence",
        "from_state",
        "to_state",
        "reason",
        "sample_cursor",
        "completed_block_count"
      ],
      "title": "StateTransitionRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
