      "required": [
        "xrun_count",
        "dropout_count",
        "short_read_count",
        "clipping_count",
        "error_count"
      ],
      "title": "CaptureFaultCounters",
      "type": "object"
    },
    "CaptureState": {
      "enum": [
        "created",
        "prepared",
        "armed",
        "running",
        "completed",
        "failed",
        "aborted"
      ],
      "title": "CaptureState",
      "type": "string"
    },
    "LoadingDirection": {
      "enum": [
        "loading",
        "unloading",
        "not_applicable",
        "unknown"
      ],
      "title": "LoadingDirection",
      "type": "string"
    },
    "NodeState": {
      "additionalProperties": false,
      "properties": {
        "continuous_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Continuous Value"
        },
        "discrete_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discrete Label"
        },
        "loading_direction": {
          "$ref": "#/$defs/LoadingDirection"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
