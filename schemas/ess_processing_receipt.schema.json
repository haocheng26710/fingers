      "type": "string"
    },
    "latency_method": {
      "const": "normalized_full_sweep_matched_correlation",
      "title": "Latency Method",
      "type": "string"
    },
    "matched_correlation_absolute": {
      "maximum": 1,
      "minimum": 0,
      "title": "Matched Correlation Absolute",
      "type": "number"
    },
    "matched_correlation_signed": {
      "maximum": 1,
      "minimum": -1,
      "title": "Matched Correlation Signed",
      "type": "number"
    },
    "output_after_pre_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Output After Pre Sample Count",
      "type": "integer"
    },
