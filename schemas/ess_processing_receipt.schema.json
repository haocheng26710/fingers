{
  "$defs": {
    "ConfigLayer": {
      "enum": [
        "device_manifest",
        "audio_config",
        "protocol_config",
        "analysis_config",
        "synthetic_config"
      ],
      "type": "string"
    },
    "ConfigSnapshot": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "$ref": "#/$defs/ConfigLayer"
        },
        "normalized_sha256": {
          "title": "Normalized Sha256",
          "type": "string"
        },
        "original_relative_path": {
          "minLength": 1,
          "title": "Original Relative Path",
          "type": "string"
        },
        "original_sha256": {
          "title": "Original Sha256",
          "type": "string"
        },
        "validation_status": {
          "const": "valid",
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "original_relative_path",
        "original_sha256",
        "normalized_sha256",
        "validation_status"
      ],
      "title": "ConfigSnapshot",
      "type": "object"
    },
    "ProcessingArrayDescriptor": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "float64",
            "int64",
            "bool"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Name",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "name",
        "dtype",
        "shape",
        "raw_sha256"
      ],
      "title": "ProcessingArrayDescriptor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "absolute_spl_calibrated": {
      "const": false,
      "title": "Absolute Spl Calibrated",
      "type": "boolean"
    },
    "algorithm_id": {
      "const": "offline_ess_deconvolution_transfer",
      "title": "Algorithm Id",
      "type": "string"
    },
    "algorithm_version": {
      "const": "1.0.0",
      "title": "Algorithm Version",
      "type": "string"
    },
    "alignment_method": {
      "const": "zero_fill_no_circular_wrap",
      "title": "Alignment Method",
      "type": "string"
    },
    "analysis_band_lower_hz": {
      "exclusiveMinimum": 0,
      "title": "Analysis Band Lower Hz",
      "type": "number"
    },
    "analysis_band_upper_hz": {
      "exclusiveMinimum": 0,
      "title": "Analysis Band Upper Hz",
      "type": "number"
    },
    "analysis_config_normalized_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Config Normalized Sha256",
      "type": "string"
    },
    "analysis_config_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Config Raw Sha256",
      "type": "string"
    },
    "analysis_config_reference": {
      "title": "Analysis Config Reference",
      "type": "string"
    },
    "array_descriptors": {
      "additionalProperties": {
        "$ref": "#/$defs/ProcessingArrayDescriptor"
      },
      "title": "Array Descriptors",
      "type": "object"
    },
    "bundle_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Content Sha256",
      "type": "string"
    },
    "calibration_applied": {
      "const": false,
      "title": "Calibration Applied",
      "type": "boolean"
    },
    "calibration_file_verified": {
      "const": false,
      "title": "Calibration File Verified",
      "type": "boolean"
    },
    "candidate_lag_max": {
      "minimum": 0,
      "title": "Candidate Lag Max",
      "type": "integer"
    },
    "candidate_lag_min": {
      "const": 0,
      "title": "Candidate Lag Min",
      "type": "integer"
    },
    "channel_mapping_verified": {
      "const": false,
      "title": "Channel Mapping Verified",
      "type": "boolean"
    },
    "config_snapshots": {
      "additionalProperties": {
        "$ref": "#/$defs/ConfigSnapshot"
      },
      "title": "Config Snapshots",
      "type": "object"
    },
    "convolution_method": {
      "const": "full_linear_rfft_power_of_two",
      "title": "Convolution Method",
      "type": "string"
    },
    "create_only": {
      "const": true,
      "title": "Create Only",
      "type": "boolean"
    },
    "data_origin": {
      "const": "synthetic",
      "title": "Data Origin",
      "type": "string"
    },
    "db_floor_strategy": {
      "const": "numpy_float64_tiny_before_log10",
      "title": "Db Floor Strategy",
      "type": "string"
    },
    "deconvolution_fft_length": {
      "exclusiveMinimum": 0,
      "title": "Deconvolution Fft Length",
      "type": "integer"
    },
    "deconvolution_time_origin": {
      "const": "reference_deconvolution_unique_absolute_peak",
      "title": "Deconvolution Time Origin",
      "type": "string"
    },
    "device_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Device Manifest Sha256",
      "type": "string"
    },
    "electrical_loopback_available": {
      "const": false,
      "title": "Electrical Loopback Available",
      "type": "boolean"
    },
    "estimated_latency_samples": {
      "minimum": 0,
      "title": "Estimated Latency Samples",
      "type": "integer"
    },
    "estimated_latency_seconds": {
      "minimum": 0,
      "title": "Estimated Latency Seconds",
      "type": "number"
    },
    "experimental_result": {
      "const": false,
      "title": "Experimental Result",
      "type": "boolean"
    },
    "formal_eligible": {
      "const": false,
      "title": "Formal Eligible",
      "type": "boolean"
    },
    "frequency_bin_count": {
      "exclusiveMinimum": 0,
      "title": "Frequency Bin Count",
      "type": "integer"
    },
    "full_duplex_verified": {
      "const": false,
      "title": "Full Duplex Verified",
      "type": "boolean"
    },
    "hardware_io_performed": {
      "const": false,
      "title": "Hardware Io Performed",
      "type": "boolean"
    },
    "hardware_ready": {
      "const": false,
      "title": "Hardware Ready",
      "type": "boolean"
    },
    "immutable": {
      "const": true,
      "title": "Immutable",
      "type": "boolean"
    },
