      "exclusiveMinimum": 0,
      "title": "Input After Pre Sample Count",
      "type": "integer"
    },
    "input_deconvolution_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Input Deconvolution Sample Count",
      "type": "integer"
    },
    "inverse_fft_length": {
      "exclusiveMinimum": 0,
      "title": "Inverse Fft Length",
      "type": "integer"
    },
    "inverse_filter_formula": {
      "const": "s[N-1-n]*exp(-ln(f_end/f_start)*n/N)",
      "title": "Inverse Filter Formula",
      "type": "string"
    },
    "inverse_filter_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Inverse Filter Sample Count",
      "type": "integer"
    },
    "inverse_formula_id": {
      "const": "farina_exponential_sweep_amplitude_compensation",
      "title": "Inverse Formula Id",
      "type": "string"
    },
    "inverse_normalization_factor": {
      "title": "Inverse Normalization Factor",
      "type": "number"
    },
    "inverse_post_normalization_peak": {
      "exclusiveMinimum": 0,
      "title": "Inverse Post Normalization Peak",
      "type": "number"
    },
    "inverse_pre_normalization_peak": {
      "exclusiveMinimum": 0,
