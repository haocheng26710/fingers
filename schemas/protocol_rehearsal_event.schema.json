{
  "additionalProperties": false,
  "properties": {
    "after_rehearsal_state": {
      "enum": [
        "active",
        "paused",
        "failed",
        "aborted",
        "complete"
      ],
      "title": "After Rehearsal State",
      "type": "string"
    },
    "after_work_order_phase": {
      "anyOf": [
        {
          "enum": [
            "awaiting_requirements_presentation",
            "requirements_presented",
            "claimed",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "After Work Order Phase"
    },
    "before_rehearsal_state": {
      "enum": [
        "active",
        "paused",
        "failed",
        "aborted",
        "complete"
      ],
      "title": "Before Rehearsal State",
      "type": "string"
    },
    "before_work_order_phase": {
      "anyOf": [
        {
          "enum": [
            "awaiting_requirements_presentation",
            "requirements_presented",
            "claimed",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Before Work Order Phase"
    },
    "compiled_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Compiled Plan Sha256",
      "type": "string"
    },
    "current_work_order_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Current Work Order Sha256",
      "type": "string"
    },
    "derived_cursor_after": {
      "minimum": 0,
      "title": "Derived Cursor After",
      "type": "integer"
    },
    "derived_cursor_before": {
      "minimum": 0,
      "title": "Derived Cursor Before",
      "type": "integer"
    },
    "detail": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "development_rehearsal": {
      "const": true,
      "title": "Development Rehearsal",
      "type": "boolean"
    },
    "event_sequence": {
      "exclusiveMinimum": 0,
      "title": "Event Sequence",
      "type": "integer"
    },
    "event_type": {
      "enum": [
        "requirements_presented",
        "work_order_claimed",
        "work_order_rehearsed",
        "work_order_failed",
        "work_order_retry_requested",
        "rehearsal_paused",
        "rehearsal_resumed",
        "rehearsal_aborted"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "experimental_result": {
      "const": false,
      "title": "Experimental Result",
      "type": "boolean"
    },
    "formal_eligible": {
      "const": false,
      "title": "Formal Eligible",
      "type": "boolean"
    },
    "hardware_io_performed": {
      "const": false,
      "title": "Hardware Io Performed",
      "type": "boolean"
    },
    "hardware_ready": {
      "const": false,
      "title": "Hardware Ready",
      "type": "boolean"
    },
    "measurement_performed": {
      "const": false,
      "title": "Measurement Performed",
      "type": "boolean"
    },
    "operator_confirmation_status": {
      "const": "pending",
      "title": "Operator Confirmation Status",
      "type": "string"
    },
    "physical_operator_confirmation_performed": {
      "const": false,
      "title": "Physical Operator Confirmation Performed",
      "type": "boolean"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "previous_event_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Previous Event Sha256",
      "type": "string"
    },
    "protocol_execution_performed": {
      "const": false,
      "title": "Protocol Execution Performed",
      "type": "boolean"
    },
    "reason_code": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "rehearsal_actor_id": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Rehearsal Actor Id",
      "type": "string"
    },
    "rehearsal_id": {
      "title": "Rehearsal Id",
      "type": "string"
    },
    "requirements_presented_for_rehearsal": {
      "title": "Requirements Presented For Rehearsal",
      "type": "boolean"
    },
    "safety_marker": {
      "const": "DEVELOPMENT_PROTOCOL_REHEARSAL_NOT_EXECUTED_NOT_AN_EXPERIMENTAL_RESULT",
      "title": "Safety Marker",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "rehearsal_id",
    "event_sequence",
    "event_type",
    "previous_event_sha256",
    "plan_id",
    "compiled_plan_sha256",
    "current_work_order_sha256",
    "rehearsal_actor_id",
    "before_rehearsal_state",
    "after_rehearsal_state",
    "before_work_order_phase",
    "after_work_order_phase",
    "derived_cursor_before",
    "derived_cursor_after",
    "recorded_at",
    "development_rehearsal",
    "requirements_presented_for_rehearsal",
    "physical_operator_confirmation_performed",
    "operator_confirmation_status",
    "protocol_execution_performed",
    "measurement_performed",
    "hardware_io_performed",
    "hardware_ready",
    "formal_eligible",
    "experimental_result",
    "safety_marker"
  ],
  "title": "ProtocolRehearsalEvent",
  "type": "object"
}
