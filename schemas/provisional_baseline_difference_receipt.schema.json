{
  "$defs": {
    "BaselineDifferenceSourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Condition Id",
          "type": "string"
        },
        "condition_role": {
          "enum": [
            "all_blk_reference",
            "single_bridge_candidate"
          ],
          "title": "Condition Role",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/RepeatabilityMemberProvenance"
          },
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "non_blk_node_count": {
          "maximum": 1,
          "minimum": 0,
          "title": "Non Blk Node Count",
          "type": "integer"
        },
        "normalized_member_list_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Normalized Member List Sha256",
          "type": "string"
        },
        "reassembly_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Reassembly Id",
          "type": "string"
        },
        "repeat_set_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Repeat Set Id",
          "type": "string"
        },
        "repeatability_metrics_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repeatability Metrics Sha256",
          "type": "string"
        },
        "repeatability_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repeatability Receipt Sha256",
          "type": "string"
        },
        "resolved_node_states": {
          "additionalProperties": {
            "$ref": "#/$defs/NodeState"
          },
          "title": "Resolved Node States",
          "type": "object"
        },
        "resolved_node_states_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolved Node States Sha256",
          "type": "string"
        }
      },
      "required": [
        "reassembly_id",
        "repeat_set_id",
        "condition_id",
        "condition_role",
        "resolved_node_states",
        "resolved_node_states_sha256",
        "non_blk_node_count",
        "members",
        "normalized_member_list_sha256",
        "repeatability_metrics_sha256",
        "repeatability_receipt_sha256"
      ],
      "title": "BaselineDifferenceSourceProvenance",
      "type": "object"
    },
    "ConfigLayer": {
      "enum": [
        "device_manifest",
        "audio_config",
        "protocol_config",
        "analysis_config",
        "synthetic_config"
      ],
      "type": "string"
    },
    "ConfigSnapshot": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "$ref": "#/$defs/ConfigLayer"
        },
        "normalized_sha256": {
          "title": "Normalized Sha256",
          "type": "string"
        },
        "original_relative_path": {
          "minLength": 1,
          "title": "Original Relative Path",
          "type": "string"
        },
        "original_sha256": {
          "title": "Original Sha256",
          "type": "string"
        },
        "validation_status": {
          "const": "valid",
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "original_relative_path",
        "original_sha256",
        "normalized_sha256",
        "validation_status"
      ],
      "title": "ConfigSnapshot",
      "type": "object"
    },
    "LoadingDirection": {
      "enum": [
        "loading",
        "unloading",
        "not_applicable",
        "unknown"
      ],
      "title": "LoadingDirection",
      "type": "string"
    },
    "NodeState": {
      "additionalProperties": false,
      "properties": {
        "continuous_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Continuous Value"
        },
        "discrete_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discrete Label"
        },
        "loading_direction": {
          "$ref": "#/$defs/LoadingDirection"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "provenance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provenance"
        },
        "proxy_state": {
          "title": "Proxy State",
          "type": "boolean"
        },
        "state_id": {
          "title": "State Id",
          "type": "string"
        },
        "state_type": {
          "title": "State Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "node_id",
        "state_id",
        "module_id",
        "state_type",
        "discrete_label",
        "continuous_value",
        "unit",
        "loading_direction",
        "proxy_state",
        "provenance",
        "notes"
      ],
      "title": "NodeState",
      "type": "object"
    },
    "RepeatabilityMemberIdentity": {
      "additionalProperties": false,
      "properties": {
        "processing_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Processing Id",
          "type": "string"
        },
        "qc_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Qc Id",
          "type": "string"
        },
        "source_run_id": {
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Source Run Id",
          "type": "string"
        }
      },
      "required": [
        "source_run_id",
        "processing_id",
        "qc_id"
      ],
      "title": "RepeatabilityMemberIdentity",
      "type": "object"
    },
    "RepeatabilityMemberProvenance": {
      "additionalProperties": false,
      "properties": {
        "capture_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Capture Receipt Sha256",
          "type": "string"
        },
        "captured_input_wav_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Captured Input Wav Sha256",
          "type": "string"
        },
        "estimated_latency_samples": {
          "minimum": 0,
          "title": "Estimated Latency Samples",
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/RepeatabilityMemberIdentity"
        },
        "measurement_order": {
          "minimum": 0,
          "title": "Measurement Order",
          "type": "integer"
        },
        "processing_arrays_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Processing Arrays Sha256",
          "type": "string"
        },
        "processing_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Processing Receipt Sha256",
          "type": "string"
        },
        "qc_metrics_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qc Metrics Sha256",
          "type": "string"
        },
        "qc_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Qc Receipt Sha256",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "measurement_order",
        "estimated_latency_samples",
        "capture_receipt_sha256",
        "captured_input_wav_sha256",
        "processing_receipt_sha256",
        "processing_arrays_sha256",
        "qc_metrics_sha256",
        "qc_receipt_sha256"
      ],
      "title": "RepeatabilityMemberProvenance",
      "type": "object"
    }
