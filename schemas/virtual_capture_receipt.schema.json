{
  "$defs": {
    "BlockTraceRecord": {
      "additionalProperties": false,
      "properties": {
        "input_frame_count": {
          "minimum": 0,
          "title": "Input Frame Count",
          "type": "integer"
        },
        "output_frame_count": {
          "minimum": 0,
          "title": "Output Frame Count",
          "type": "integer"
        },
        "requested_frame_count": {
          "exclusiveMinimum": 0,
          "title": "Requested Frame Count",
          "type": "integer"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "start_frame": {
          "minimum": 0,
          "title": "Start Frame",
          "type": "integer"
        },
        "status_flags": {
          "items": {
            "type": "string"
          },
          "title": "Status Flags",
          "type": "array"
        }
      },
      "required": [
        "sequence",
        "start_frame",
        "requested_frame_count",
        "output_frame_count",
        "input_frame_count",
        "status_flags"
      ],
      "title": "BlockTraceRecord",
      "type": "object"
    },
    "CaptureFaultCounters": {
      "additionalProperties": false,
      "properties": {
        "clipping_count": {
          "minimum": 0,
          "title": "Clipping Count",
          "type": "integer"
        },
        "dropout_count": {
          "minimum": 0,
          "title": "Dropout Count",
          "type": "integer"
        },
        "error_count": {
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "short_read_count": {
          "minimum": 0,
          "title": "Short Read Count",
          "type": "integer"
        },
        "xrun_count": {
          "minimum": 0,
          "title": "Xrun Count",
          "type": "integer"
        }
      },
      "required": [
        "xrun_count",
        "dropout_count",
        "short_read_count",
        "clipping_count",
        "error_count"
      ],
      "title": "CaptureFaultCounters",
      "type": "object"
    },
    "CaptureState": {
      "enum": [
        "created",
        "prepared",
        "armed",
        "running",
        "completed",
        "failed",
        "aborted"
      ],
      "title": "CaptureState",
      "type": "string"
    },
    "ConfigLayer": {
      "enum": [
        "device_manifest",
        "audio_config",
        "protocol_config",
        "analysis_config",
        "synthetic_config"
      ],
      "type": "string"
    },
    "ConfigSnapshot": {
      "additionalProperties": false,
      "properties": {
        "layer": {
          "$ref": "#/$defs/ConfigLayer"
        },
        "normalized_sha256": {
          "title": "Normalized Sha256",
          "type": "string"
        },
        "original_relative_path": {
          "minLength": 1,
          "title": "Original Relative Path",
          "type": "string"
        },
        "original_sha256": {
          "title": "Original Sha256",
          "type": "string"
        },
        "validation_status": {
          "const": "valid",
          "title": "Validation Status",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "original_relative_path",
        "original_sha256",
        "normalized_sha256",
        "validation_status"
      ],
      "title": "ConfigSnapshot",
      "type": "object"
    },
    "StateTransitionRecord": {
      "additionalProperties": false,
      "properties": {
        "completed_block_count": {
          "minimum": 0,
          "title": "Completed Block Count",
          "type": "integer"
        },
        "from_state": {
          "$ref": "#/$defs/CaptureState"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sample_cursor": {
          "minimum": 0,
          "title": "Sample Cursor",
          "type": "integer"
        },
        "sequence": {
          "exclusiveMinimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "to_state": {
          "$ref": "#/$defs/CaptureState"
        }
      },
      "required": [
        "sequence",
        "from_state",
        "to_state",
        "reason",
        "sample_cursor",
        "completed_block_count"
      ],
      "title": "StateTransitionRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "absolute_spl_calibrated": {
      "const": false,
      "title": "Absolute Spl Calibrated",
      "type": "boolean"
    },
    "actual_block_count": {
      "exclusiveMinimum": 0,
      "title": "Actual Block Count",
      "type": "integer"
    },
    "actual_input_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Actual Input Sample Count",
      "type": "integer"
    },
    "actual_output_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Actual Output Sample Count",
      "type": "integer"
    },
    "all_finite": {
      "const": true,
      "title": "All Finite",
      "type": "boolean"
    },
    "backend_id": {
      "const": "deterministic_virtual_duplex",
      "title": "Backend Id",
      "type": "string"
    },
    "backend_version": {
      "const": "1.0.0",
      "title": "Backend Version",
      "type": "string"
    },
    "block_size_frames": {
      "exclusiveMinimum": 0,
      "title": "Block Size Frames",
      "type": "integer"
    },
    "block_trace": {
      "items": {
        "$ref": "#/$defs/BlockTraceRecord"
      },
      "title": "Block Trace",
      "type": "array"
    },
    "bundle_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Content Sha256",
      "type": "string"
    },
    "calibration_applied": {
      "const": false,
      "title": "Calibration Applied",
      "type": "boolean"
    },
    "calibration_file_verified": {
      "const": false,
      "title": "Calibration File Verified",
      "type": "boolean"
    },
    "capture_id": {
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Capture Id",
      "type": "string"
    },
    "capture_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Capture Sample Count",
      "type": "integer"
    },
    "capture_tail_sample_count": {
      "minimum": 0,
      "title": "Capture Tail Sample Count",
      "type": "integer"
    },
    "channel_mapping_verified": {
      "const": false,
      "title": "Channel Mapping Verified",
      "type": "boolean"
    },
    "config_snapshots": {
      "additionalProperties": {
        "$ref": "#/$defs/ConfigSnapshot"
      },
      "title": "Config Snapshots",
      "type": "object"
    },
    "create_only": {
      "const": true,
      "title": "Create Only",
      "type": "boolean"
    },
    "data_origin": {
      "const": "synthetic",
      "title": "Data Origin",
      "type": "string"
    },
    "device_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Device Manifest Sha256",
      "type": "string"
    },
    "electrical_loopback_available": {
      "const": false,
      "title": "Electrical Loopback Available",
      "type": "boolean"
    },
    "ess_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Ess Sample Count",
      "type": "integer"
    },
    "experimental_result": {
      "const": false,
      "title": "Experimental Result",
      "type": "boolean"
    },
    "fault_counters": {
      "$ref": "#/$defs/CaptureFaultCounters"
    },
    "final_state": {
      "const": "completed",
      "title": "Final State",
      "type": "string"
    },
    "formal_eligible": {
      "const": false,
      "title": "Formal Eligible",
      "type": "boolean"
    },
    "full_duplex_verified": {
      "const": false,
      "title": "Full Duplex Verified",
      "type": "boolean"
    },
    "hardware_io_performed": {
      "const": false,
      "title": "Hardware Io Performed",
      "type": "boolean"
    },
    "hardware_ready": {
      "const": false,
      "title": "Hardware Ready",
      "type": "boolean"
    },
    "immutable": {
      "const": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "input_dtype": {
      "const": "float32",
      "title": "Input Dtype",
      "type": "string"
    },
    "input_raw_float32_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Raw Float32 Sha256",
      "type": "string"
    },
    "input_shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": 1,
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Input Shape",
      "type": "array"
    },
    "input_wav_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Wav Sha256",
      "type": "string"
    },
    "integer_latency_samples": {
      "minimum": 0,
      "title": "Integer Latency Samples",
      "type": "integer"
    },
    "last_block_frame_count": {
      "exclusiveMinimum": 0,
      "title": "Last Block Frame Count",
      "type": "integer"
    },
    "linear_gain": {
      "exclusiveMinimum": 0,
      "title": "Linear Gain",
      "type": "number"
    },
    "output_dtype": {
      "const": "float32",
      "title": "Output Dtype",
      "type": "string"
    },
    "output_raw_float32_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Raw Float32 Sha256",
      "type": "string"
    },
    "output_shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": 1,
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Output Shape",
      "type": "array"
    },
    "output_wav_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Wav Sha256",
      "type": "string"
    },
    "planned_block_count": {
      "exclusiveMinimum": 0,
      "title": "Planned Block Count",
      "type": "integer"
    },
    "planned_input_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Planned Input Sample Count",
      "type": "integer"
    },
    "planned_output_sample_count": {
      "exclusiveMinimum": 0,
      "title": "Planned Output Sample Count",
      "type": "integer"
    },
    "playback_performed": {
      "const": false,
      "title": "Playback Performed",
      "type": "boolean"
    },
    "protocol_execution_performed": {
      "const": false,
      "title": "Protocol Execution Performed",
      "type": "boolean"
    },
    "protocol_id": {
      "title": "Protocol Id",
      "type": "string"
    },
    "reassembly_id": {
      "title": "Reassembly Id",
      "type": "string"
    },
    "recording_performed": {
      "const": false,
      "title": "Recording Performed",
      "type": "boolean"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_mode": {
      "const": "development",
      "title": "Run Mode",
      "type": "string"
    },
    "safety_marker": {
      "const": "SYNTHETIC_VIRTUAL_CAPTURE_NOT_AN_EXPERIMENTAL_RESULT",
      "title": "Safety Marker",
      "type": "string"
    },
    "scenario_normalized_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Normalized Sha256",
      "type": "string"
    },
    "scenario_raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scenario Raw Sha256",
      "type": "string"
    },
    "scenario_reference": {
      "title": "Scenario Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "shared_clock_verified": {
      "const": false,
      "title": "Shared Clock Verified",
      "type": "boolean"
    },
    "source_ess_artifact_id": {
      "title": "Source Ess Artifact Id",
      "type": "string"
    },
    "source_ess_metadata_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Ess Metadata Sha256",
      "type": "string"
    },
    "source_ess_raw_float32_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Ess Raw Float32 Sha256",
      "type": "string"
    },
    "source_ess_wav_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Ess Wav Sha256",
      "type": "string"
    },
    "state_transition_trace": {
      "items": {
        "$ref": "#/$defs/StateTransitionRecord"
      },
      "title": "State Transition Trace",
      "type": "array"
    },
    "virtual_duplex_scheduler_exercised": {
      "const": true,
      "title": "Virtual Duplex Scheduler Exercised",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "capture_id",
    "run_id",
    "session_id",
    "reassembly_id",
    "data_origin",
    "run_mode",
    "backend_id",
    "backend_version",
    "scenario_reference",
    "scenario_raw_sha256",
    "scenario_normalized_sha256",
    "bundle_content_sha256",
    "device_manifest_sha256",
    "config_snapshots",
    "protocol_id",
    "protocol_execution_performed",
    "source_ess_artifact_id",
    "source_ess_metadata_sha256",
    "source_ess_wav_sha256",
    "source_ess_raw_float32_sha256",
    "ess_sample_count",
    "capture_tail_sample_count",
    "capture_sample_count",
    "planned_output_sample_count",
    "actual_output_sample_count",
    "planned_input_sample_count",
    "actual_input_sample_count",
    "block_size_frames",
    "planned_block_count",
    "actual_block_count",
    "last_block_frame_count",
    "integer_latency_samples",
    "linear_gain",
    "output_shape",
    "input_shape",
    "output_dtype",
    "input_dtype",
    "output_raw_float32_sha256",
    "input_raw_float32_sha256",
    "output_wav_sha256",
    "input_wav_sha256",
    "block_trace",
    "state_transition_trace",
    "fault_counters",
    "final_state",
    "all_finite",
    "create_only",
    "immutable",
    "virtual_duplex_scheduler_exercised",
    "hardware_io_performed",
    "playback_performed",
    "recording_performed",
    "hardware_ready",
    "full_duplex_verified",
    "shared_clock_verified",
    "channel_mapping_verified",
    "calibration_file_verified",
    "calibration_applied",
    "absolute_spl_calibrated",
    "electrical_loopback_available",
    "formal_eligible",
    "experimental_result",
    "safety_marker"
  ],
  "title": "VirtualCaptureReceipt",
  "type": "object"
}
