{
  "$defs": {
    "AudioChannel": {
      "additionalProperties": false,
      "properties": {
        "channel_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Channel Index"
        },
        "role": {
          "enum": [
            "TX_speaker",
            "RX_microphone",
            "diagnostic_reference"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "channel_index",
        "role"
      ],
      "title": "AudioChannel",
      "type": "object"
    },
    "AudioDeviceRef": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Id"
        },
        "device_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Name"
        }
      },
      "required": [
        "device_id",
        "device_name"
      ],
      "title": "AudioDeviceRef",
      "type": "object"
    },
    "ConfigStatus": {
      "enum": [
        "draft",
        "ready"
      ],
      "title": "ConfigStatus",
      "type": "string"
    },
    "RunMode": {
      "enum": [
        "formal",
        "diagnostic",
        "development"
      ],
      "title": "RunMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audio_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Audio Backend"
    },
    "config_id": {
      "title": "Config Id",
      "type": "string"
    },
    "config_status": {
      "$ref": "#/$defs/ConfigStatus"
    },
    "ess_digital_peak_dbfs": {
      "anyOf": [
        {
          "maximum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ess Digital Peak Dbfs"
    },
    "ess_duration_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ess Duration S"
    },
    "ess_end_frequency_hz": {
      "exclusiveMinimum": 0,
      "title": "Ess End Frequency Hz",
      "type": "number"
    },
    "ess_fade_in_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ess Fade In S"
    },
    "ess_fade_out_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ess Fade Out S"
    },
    "ess_start_frequency_hz": {
      "exclusiveMinimum": 0,
      "title": "Ess Start Frequency Hz",
      "type": "number"
    },
    "experimental_result": {
      "title": "Experimental Result",
      "type": "boolean"
    },
    "formal_eligible": {
      "title": "Formal Eligible",
      "type": "boolean"
    },
    "hardware_ready": {
      "title": "Hardware Ready",
      "type": "boolean"
    },
    "hardware_setup_reference": {
      "title": "Hardware Setup Reference",
      "type": "string"
    },
    "host_api_candidate_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Host Api Candidate Index"
    },
    "input_candidate_device_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Candidate Device Index"
    },
    "input_channels": {
      "items": {
        "$ref": "#/$defs/AudioChannel"
      },
      "title": "Input Channels",
      "type": "array"
    },
    "input_device": {
      "$ref": "#/$defs/AudioDeviceRef"
    },
    "input_gain_db": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Gain Db"
    },
    "inventory_snapshot_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inventory Snapshot Reference"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "operator_confirmation_status": {
      "enum": [
        "needs_operator_confirmation",
        "confirmed"
      ],
      "title": "Operator Confirmation Status",
      "type": "string"
    },
    "output_candidate_device_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Candidate Device Index"
    },
    "output_channels": {
      "items": {
        "$ref": "#/$defs/AudioChannel"
      },
      "title": "Output Channels",
      "type": "array"
    },
    "output_device": {
      "$ref": "#/$defs/AudioDeviceRef"
    },
    "output_gain_db": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Output Gain Db"
    },
    "playback_authorized": {
      "title": "Playback Authorized",
      "type": "boolean"
    },
    "post_silence_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Post Silence S"
    },
    "pre_silence_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pre Silence S"
    },
    "run_mode": {
      "$ref": "#/$defs/RunMode"
    },
    "sample_rate_hz": {
      "exclusiveMinimum": 0,
      "title": "Sample Rate Hz",
      "type": "integer"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "config_id",
    "config_status",
    "run_mode",
    "audio_backend",
    "hardware_setup_reference",
    "inventory_snapshot_reference",
    "input_candidate_device_index",
    "output_candidate_device_index",
    "host_api_candidate_index",
    "operator_confirmation_status",
    "output_device",
    "input_device",
    "output_channels",
    "input_channels",
    "sample_rate_hz",
    "ess_start_frequency_hz",
    "ess_end_frequency_hz",
    "ess_duration_s",
    "pre_silence_s",
    "post_silence_s",
    "ess_fade_in_s",
    "ess_fade_out_s",
    "ess_digital_peak_dbfs",
    "playback_authorized",
    "formal_eligible",
    "experimental_result",
    "output_gain_db",
    "input_gain_db",
    "hardware_ready",
    "notes"
  ],
  "title": "AudioConfig",
  "type": "object"
}
